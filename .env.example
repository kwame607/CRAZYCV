# Copy to .env.local for local development. Never commit real values.
# All NEXT_PUBLIC_* values are visible to every visitor. Do not put secrets in them.

# Public site origin (used for sitemap, Open Graph, canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact details shown on the site. Leave empty to show "not configured".
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Release information shown in System Overview (via /api/system).
# APP_VERSION falls back to package.json "version" when unset.
APP_VERSION=
# Build identifier (e.g. git commit SHA). Falls back to common host variables
# (VERCEL_GIT_COMMIT_SHA, CF_PAGES_COMMIT_SHA, GITHUB_SHA), else "not configured".
BUILD_ID=
# Deployment environment label (production, preview, ...). Falls back to NODE_ENV.
DEPLOY_ENV=
